# Copy to .env (gitignored) for local development: cp .env.example .env
# Production values live in Worker secrets / GitHub repo secrets; see README.md#configuration.

# --- Local UI work: allow the dev server origin (comma-separated) ---
ALLOWED_ORIGIN=https://thanikc.github.io,http://localhost:4200

# --- LLM provider keys: at least one is required (tried in this order) ---
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- Security secrets ---
# Generate with: openssl rand -base64 32. `pnpm ingest` reads this to mint ingest tokens.
INGEST_TOKEN=
# Any string locally; the chat gate is on only when this and TURNSTILE_SECRET are both set.
SESSION_SECRET=local-dev-only
# Cloudflare's always-pass test secret; use a real widget secret only in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Deploy credentials: only needed to run wrangler deploy/secret commands locally ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
