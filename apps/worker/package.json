{
  "name": "@thanikc/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "ingest": "node scripts/ingest.mjs",
    "ingest:deployed": "node scripts/ingest.mjs --url https://thanikc-worker.thanikc.workers.dev",
    "eval": "node scripts/eval.mjs --delay 7000 --log eval.log",
    "eval:deployed": "node scripts/eval.mjs --url https://thanikc-worker.thanikc.workers.dev --delay 7000 --log eval.log",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
