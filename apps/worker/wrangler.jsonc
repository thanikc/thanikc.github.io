{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thanikc-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // AI and Vectorize have no local emulator; `wrangler dev` talks to the real
  // resources. The Vitest plugin sets `remoteBindings: false` and every test stubs
  // these bindings through an explicit `env`.
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "resume-rag",
      "remote": true,
    },
  ],
  // Answer cache. Created with `wrangler d1 create thanikc-cache`.
  // CI applies migrations/ before each deploy (`wrangler d1 migrations apply CACHE_DB --remote`).
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "database_name": "thanikc-cache",
      "database_id": "c7a9ea29-9726-42a7-8209-e9386be16f15",
      "migrations_dir": "migrations",
    },
  ],
  // One data point per chat request; query with the Analytics Engine SQL API.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "ai_ling_chat" }],
  // Native rate limiters: 10 chat requests per minute per client IP, and 60 per minute
  // for everyone together, so many IPs can't drain the free-tier provider quotas.
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "CHAT_LIMIT_GLOBAL",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "vars": {
    // Comma-separated; add http://localhost:4200 in .dev.vars for local UI work.
    "ALLOWED_ORIGIN": "https://thanikc.github.io",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "GOOGLE_MODEL": "gemini-flash-latest",
    "OPENROUTER_MODEL": "openrouter/free",
    // Uncached answers generated per UTC day; past it Ling answers "busy". Keep below the
    // smallest free provider quota (confirm against the Groq console).
    "DAILY_GENERATION_LIMIT": 1000,
  },
  // Secrets (set with `wrangler secret put` or via CI), never committed:
  //   GROQ_API_KEY, GOOGLE_AI_API_KEY, OPENROUTER_API_KEY, INGEST_TOKEN
}
