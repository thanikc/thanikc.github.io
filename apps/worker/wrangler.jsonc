{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thanikc-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // AI and Vectorize have no local emulator; `wrangler dev` talks to the real
  // resources. The Vitest plugin sets `remoteBindings: false` and every test stubs
  // these bindings through an explicit `env`.
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "resume-rag",
      "remote": true,
    },
  ],
  // Answer cache. No database_id: `wrangler deploy` provisions the database by name.
  // Apply the schema with `wrangler d1 migrations apply CACHE_DB --remote`.
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "database_name": "thanikc-cache",
      "migrations_dir": "migrations",
    },
  ],
  // Native rate limiter: 10 chat requests per minute per client IP.
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://thanikc.github.io",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "GOOGLE_MODEL": "gemini-flash-latest",
    "OPENROUTER_MODEL": "openrouter/free",
    // Bump after re-ingesting so cached answers grounded on old content stop being served.
    "CACHE_EPOCH": "1",
  },
  // Secrets (set with `wrangler secret put` or via CI), never committed:
  //   GROQ_API_KEY, GOOGLE_AI_API_KEY, OPENROUTER_API_KEY, INGEST_TOKEN
}
