{
  "name": "@thanikc/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration=production && node scripts/emit-pages-root.mjs && node scripts/add-csp.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "pnpm test:scripts && ng test --watch=false",
    "test:scripts": "node --test scripts/add-csp.test.mjs",
    "i18n:extract": "ng extract-i18n --format=json --output-path=src/locale --out-file=messages.json",
    "i18n:check": "pnpm i18n:extract && node scripts/check-translations.mjs && rm src/locale/messages.json",
    "test:watch": "ng test",
    "e2e:design": "pnpm build:pages && playwright test"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/localize": "22.2.5",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/ssr": "22.2.6",
    "@tailwindcss/postcss": "^4.3.5",
    "marked": "^18.1.3",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "jsdom": "^31.0.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
