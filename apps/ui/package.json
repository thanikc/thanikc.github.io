{
  "name": "@thanikc/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration=production && node scripts/emit-pages-root.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "i18n:extract": "ng extract-i18n --format=json --output-path=src/locale --out-file=messages.json",
    "i18n:check": "pnpm i18n:extract && node scripts/check-translations.mjs && rm src/locale/messages.json",
    "test:watch": "ng test",
    "e2e:design": "pnpm build:pages && playwright test"
  },
  "dependencies": {
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/localize": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-server": "22.1.1",
    "@angular/router": "22.1.1",
    "@angular/ssr": "22.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "marked": "^18.0.12",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.19",
    "@types/three": "^0.186.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
