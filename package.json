{
  "name": "thanikc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ui": "pnpm --filter @thanikc/ui",
    "worker": "pnpm --filter @thanikc/worker",
    "start": "pnpm --filter @thanikc/ui start",
    "start:ui": "pnpm --filter @thanikc/ui start",
    "start:worker": "pnpm --filter @thanikc/worker start",
    "build": "pnpm --filter @thanikc/ui build",
    "test": "pnpm -r test",
    "test:ui": "pnpm --filter @thanikc/ui test",
    "test:worker": "pnpm --filter @thanikc/worker test",
    "ingest": "pnpm --filter @thanikc/worker ingest",
    "ingest:deployed": "pnpm --filter @thanikc/worker ingest:deployed",
    "format": "prettier --write \"apps/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,html,scss,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/**/*.{ts,html,scss,css,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  }
}
