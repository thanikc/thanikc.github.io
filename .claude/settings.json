{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/out-tsc/**)",
      "Read(**/.angular/**)",
      "Read(**/.wrangler/**)",
      "Read(**/coverage/**)",
      "Read(**/.husky/_/**)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/package-lock.json)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Read(**/apps/worker/worker-configuration.d.ts)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
